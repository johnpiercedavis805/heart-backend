# HeArt v1 — environment template. Invented by John Davis.
# Copy to .env for LOCAL development only (never commit .env — it is
# gitignored). On Render, set these in the Dashboard (Environment tab);
# render.yaml already declares every key, secrets included.
# Placeholders only — NO real values in this file.

# ── REQUIRED — the app refuses to start without these three ──────────────
# Postgres connection string. Local dev: leave unset and set
# ALLOW_SQLITE_DEV=1 instead. Production: Render Postgres (auto-wired
# by render.yaml) or a Supabase project URL, e.g.
# postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# GENERATED vs COPIED: copied from the Render/Supabase dashboard.
DATABASE_URL=
# 32-byte key (64 hex chars) encrypting api_keys.signing_secret at rest
# (NaCl SecretBox). GENERATED — run:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it outside the database and out of the repo. One key per database —
# changing it orphans every stored signing secret.
SIGNING_SECRET_ENCRYPTION_KEY=
# Protects the admin key-revocation endpoint. No default by design.
# GENERATED — run:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── RECOMMENDED FOR PRODUCTION ────────────────────────────────────────────
# Ed25519 seed (64 hex chars) signing registry verification timestamps.
# If unset, the server generates an ephemeral key per process and the
# public key in /registry/:serial/verify changes on every restart, so
# verifiers cannot pin it. GENERATED — same command as the signing key.
# Publish the matching public key out-of-band for verifiers.
REGISTRY_SIGNING_KEY=

# ── API DOCS — off unless explicitly enabled ───────────────────────────────
# FastAPI's interactive docs (/docs, /redoc, /openapi.json) expose the full
# endpoint surface. This is an invite-only service, so they are OFF by
# default (T2 red-pen item 9). Set to 1 for local development only —
# never on a public deploy.
ENABLE_API_DOCS=0

# ── STRIPE — HeArt Premium ($9.99/month, flat rate) ──────────────────────
# TEST keys first (sk_test_... / pk_test_...), LIVE keys (sk_live_...)
# only at the deliberate go-live step with John's approval. The app
# refuses a live STRIPE_SECRET_KEY while STRIPE_TEST_MODE_ONLY is on.
# All values COPIED from the Stripe Dashboard (Developers → API keys).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for POST /billing/webhooks. COPIED from the
# Stripe Dashboard after adding the webhook endpoint (Developers →
# Webhooks). Test mode and live mode have DIFFERENT secrets — re-copy
# when going live.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the "HeArt Premium" product, created by
#   STRIPE_SECRET_KEY=sk_test_... python api/scripts/stripe_create_price.py
# (test mode) and the same script with the live key at go-live.
# COPIED from the script output (or the Stripe Dashboard → Products).
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY_USDC=
# Hosted Checkout redirect targets (App-to-Web path). Set when the
# subscribe page exists; until then any URL works as a placeholder for
# smoke tests. COPIED from the deployed service URL.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
# Stripe Tax collection. OFF by default (threshold monitoring only).
# Set to 1 BEFORE the first live charge. Test mode: leave 0.
STRIPE_TAX_ENABLED=0
# 1 = test mode only (default, safe). 0 = allow live keys. Flip to 0
# only at the go-live step, with John's approval.
STRIPE_TEST_MODE_ONLY=1

# ── PAYPAL — PayPal Subscriptions (HeArt Premium, $9.99/month) ───────────
# Direct PayPal Subscriptions REST API (SANDBOX only while
# PAYPAL_TEST_MODE_ONLY=1 — the module refuses the live host).
# Stripe-native PayPal is Europe-only; this US account cannot use it.
# Create in the PayPal Developer Dashboard (sandbox):
#  1. Apps & Credentials -> Create App (REST API) -> copy Client ID + Secret.
#  2. Run api/scripts/paypal_create_plan.py -> copy PAYPAL_PLAN_ID.
#  3. Same app -> Webhooks -> Add Webhook for
#     https://heart-api-ifsr.onrender.com/paypal/webhooks -> copy the
#     webhook id (WH-...) -> PAYPAL_WEBHOOK_ID.
# See docs/paypal-subscriptions.md. Never put these in the repo or chat.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
# Optional PayPal redirect targets (Nov 10, 2026 fix). When unset, the
# app derives clean defaults from the Stripe checkout URLs — the
# {CHECKOUT_SESSION_ID} placeholder is stripped, because PayPal
# rejects the braces with INVALID_PARAMETER_SYNTAX. An explicit
# return_url/cancel_url in a POST /paypal/subscribe body wins over
# these. Leave unset unless PayPal should land buyers elsewhere.
#PAYPAL_RETURN_URL=
#PAYPAL_CANCEL_URL=
# Sandbox host (default). Live is https://api-m.paypal.com — refused
# while PAYPAL_TEST_MODE_ONLY=1. For the live swap, see
# docs/paypal-subscriptions.md ("Going live"): PAYPAL_TEST_MODE_ONLY=0,
# PAYPAL_API_BASE=https://api-m.paypal.com, and the one-run opt-in
# PAYPAL_ALLOW_LIVE_PLAN=1 for scripts/paypal_create_plan.py --live
# (set it for that run only, then unset it — never leave it set).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_TEST_MODE_ONLY=1

# ── COINBASE — Bitcoin payments (HeArt Premium, one-time $9.99) ──────────
# Only needed once BTC payments go live. No sandbox exists for the
# Commerce Charge API — the module refuses to run without a key.
# COPIED from Coinbase Commerce (Settings → API Keys) and from the
# webhook subscription's shared secret in the same place.
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=
# Defaults below are the production values; override only to test
# against a different Commerce endpoint (there is no sandbox).
COINBASE_API_BASE=https://api.commerce.coinbase.com
COINBASE_API_VERSION=2018-03-22

# ── TUNABLES (safe defaults — set only to change them) ───────────────────
UPLOAD_DIR=./uploads
RATE_LIMIT_PER_HOUR=100
MAX_FILE_BYTES=10485760
MAX_WORKS_PER_DAY=1
KEY_ROTATION_DAYS=90
ROTATION_GRACE_HOURS=24

# ── LOCAL DEV ONLY — never set in production ─────────────────────────────
# Lets the app boot on local SQLite without DATABASE_URL. Production
# must NEVER set this: it would silently store everything in a
# throwaway local file that vanishes on redeploy.
ALLOW_SQLITE_DEV=0

# ── PLATFORM-PROVIDED — do not set by hand ───────────────────────────────
# PORT is injected by Render (the Dockerfile CMD uses ${PORT:-8000}).
